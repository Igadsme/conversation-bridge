{
  "name": "asl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n backend,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "npm --prefix frontend run dev",
    "build": "tsc -p tsconfig.server.json",
    "lint": "oxlint server --ignore-pattern '**/._*'",
    "start": "NODE_ENV=production node dist-server/index.js",
    "test": "node --import tsx --test server/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "concurrently": "^9.2.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2"
  },
  "optionalDependencies": {
    "@oxlint/binding-darwin-arm64": "^1.87.0"
  }
}
